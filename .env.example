# Telegram
BOT_TOKEN=replace_me
MODERATION_CHAT_ID=
PUBLISH_CHANNEL_ID=
ADMIN_IDS=123456789
DROP_PENDING_UPDATES=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://newsbot:change_me@db:5432/newsbot
POSTGRES_DB=newsbot
POSTGRES_USER=newsbot
POSTGRES_PASSWORD=change_me

# AI: GPT-4 is primary. GigaChat is an optional provider extension.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat

# Multi-source ingestion
MRC_ENABLED=true
MRC_LISTING_URL=https://www.mrc.ru/ajax/news/?query=&condition=OR
RSS_FEEDS=
SOURCE_FETCH_LIMIT=50
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_CONNECTIONS=20

LOG_LEVEL=INFO
TIMEZONE=UTC
INGESTION_INTERVAL_MINUTES=60
