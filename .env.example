# Telegram
BOT_TOKEN=replace_me
MODERATION_CHAT_ID=
PUBLISH_CHANNEL_ID=
ADMIN_IDS=123456789
DROP_PENDING_UPDATES=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://newsbot:change_me@db:5432/newsbot
POSTGRES_DB=newsbot
POSTGRES_USER=newsbot
POSTGRES_PASSWORD=change_me

# AI: GPT-4 is primary. GigaChat is an optional provider extension.
AI_PROVIDER=openai
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.2
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat

# Multi-source ingestion
MRC_ENABLED=true
MRC_LISTING_URL=https://www.mrc.ru/ajax/news/?query=&condition=OR
RSS_FEEDS=
SOURCE_FETCH_LIMIT=50
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_CONNECTIONS=20
MRC_ARTICLE_CONCURRENCY=5
SOURCE_RETRY_ATTEMPTS=3
SOURCE_RETRY_BASE_DELAY_SECONDS=0.25
SOURCE_RETRY_MAX_DELAY_SECONDS=4
SOURCE_REQUEST_INTERVAL_SECONDS=0.2

# Duplicate detection creates review candidates; it never drops or merges source articles.
DUPLICATE_LOOKBACK_DAYS=30
DUPLICATE_TITLE_SIMILARITY_THRESHOLD=0.92
DUPLICATE_CANDIDATE_LIMIT=300

LOG_LEVEL=INFO
TIMEZONE=UTC
INGESTION_INTERVAL_MINUTES=60
